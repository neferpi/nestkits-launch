# Public (baked into static export at build time)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Pages Function secrets (set in dashboard / wrangler pages secret put)
# Stripe is OPTIONAL — default path is free waitlist only.
# Enable when *you* want to charge *your* customers (see docs/STRIPE.md).
# STRIPE_SECRET_KEY=sk_test_REPLACE
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# STRIPE_PRICE_EARLY_BIRD=price_REPLACE
# STRIPE_PRICE_FOUNDER=price_REPLACE
# SITE_URL=https://your-project.pages.dev
# RESEND_API_KEY=re_REPLACE
# WAITLIST_FROM_EMAIL=Waitlist <onboarding@resend.dev>
